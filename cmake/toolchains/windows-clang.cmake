set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_VERSION 10.0)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

set(RB_WINSDK_ROOT "$ENV{WINSDK_ROOT}" CACHE PATH "Windows SDK and CRT directory prepared by xwin")
if(NOT IS_DIRECTORY "${RB_WINSDK_ROOT}/crt/include")
  message(FATAL_ERROR "Set WINSDK_ROOT to the directory containing xwin's crt and sdk folders")
endif()
find_program(CMAKE_C_COMPILER clang-cl HINTS "$ENV{LLVM_ROOT}/bin" REQUIRED)
set(CMAKE_CXX_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
find_program(CMAKE_LINKER lld-link HINTS "$ENV{LLD_ROOT}/bin" "$ENV{LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_AR llvm-lib HINTS "$ENV{LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_RC_COMPILER llvm-rc HINTS "$ENV{LLVM_ROOT}/bin" REQUIRED)
find_program(CMAKE_MT llvm-mt HINTS "$ENV{LLVM_ROOT}/bin" REQUIRED)

foreach(folder crt/include sdk/include/ucrt sdk/include/um sdk/include/shared sdk/include/winrt)
  string(APPEND _rb_include_flags " /imsvc\"${RB_WINSDK_ROOT}/${folder}\"")
  string(APPEND CMAKE_RC_FLAGS_INIT " /I\"${RB_WINSDK_ROOT}/${folder}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${_rb_include_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_rb_include_flags}")
foreach(folder crt/lib/x86_64 sdk/lib/ucrt/x86_64 sdk/lib/um/x86_64)
  string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " /libpath:\"${RB_WINSDK_ROOT}/${folder}\"")
endforeach()
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")
set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
